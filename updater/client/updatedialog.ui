<ui version="4.0">
 <class>TSSUpdateDialog</class>
 <widget class="QDialog" name="TSSUpdateDialog">
  <property name="windowTitle"><string>Application updates</string></property>
  <property name="minimumSize"><size><width>540</width><height>360</height></size></property>
  <layout class="QVBoxLayout" name="layout">
   <item><widget class="QLabel" name="status"><property name="text"><string>Check for a new application version.</string></property><property name="wordWrap"><bool>true</bool></property><property name="textFormat"><enum>Qt::PlainText</enum></property></widget></item>
   <item><widget class="QPlainTextEdit" name="notes"><property name="readOnly"><bool>true</bool></property></widget></item>
   <item><widget class="QProgressBar" name="progress"><property name="value"><number>0</number></property></widget></item>
   <item><widget class="QCheckBox" name="automaticCheck"><property name="text"><string>Check for updates automatically</string></property></widget></item>
   <item><widget class="QCheckBox" name="automaticDownload"><property name="text"><string>Download updates automatically</string></property></widget></item>
   <item><widget class="QLabel" name="hint"><property name="text"><string>Before restarting, close the other application and finish all device operations. Settings and logs will be preserved.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item><layout class="QHBoxLayout" name="buttons">
    <item><widget class="QPushButton" name="check"><property name="text"><string>Check now</string></property></widget></item>
    <item><spacer name="spacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item>
    <item><widget class="QPushButton" name="download"><property name="text"><string>Download update</string></property></widget></item>
    <item><widget class="QPushButton" name="install"><property name="text"><string>Update and restart</string></property></widget></item>
    <item><widget class="QPushButton" name="later"><property name="text"><string>Later</string></property></widget></item>
   </layout></item>
  </layout>
 </widget>
